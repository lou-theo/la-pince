{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "la-pince",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // One message per phone to notify, sent by the request that wrote the revisions and read one at a time, so that the encryption of each
  // stays within the CPU time of one invocation whatever the size of the group.
  "queues": {
    "producers": [{ "binding": "NOTIFICATIONS", "queue": "la-pince-notifications" }],
    "consumers": [{ "queue": "la-pince-notifications", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3 }],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "la-pince",
      // Local runs and tests only use it as a key; a deployed instance keeps its id in wrangler.production.jsonc (ignored by git).
      "database_id": "local",
      // Written by drizzle-kit from src/schema.ts, applied by Wrangler in file order.
      "migrations_dir": "drizzle",
    },
  ],
  // Photos of the members; a local key only, like `database_id`.
  "kv_namespaces": [{ "binding": "PHOTOS", "id": "local" }],
}
