{
  "extends": "@la-pince/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"],
  // The service worker has its own config, with the types of a worker instead of the DOM's.
  "exclude": ["src/sw"]
}
